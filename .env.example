# Bunlar Vite derlemesi sırasında okunur; değiştirdikten sonra yeniden derleyin.
VITE_SUPABASE_URL=
# Tarayıcıya yalnız publishable anahtar verilir. Secret/service_role kullanmayın.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Eski kurulumla uyumluluk; yalnız anon JWT anahtarı kabul edilir.
VITE_SUPABASE_ANON_KEY=
# Mevcut demo derleme ayarları; gerçek sağlayıcı sırları tarayıcıda tutulmamalıdır.
VITE_API_KEY=
VITE_KIE_API_KEY=
# Stripe publishable anahtarı, secret anahtarı değildir.
VITE_STRIPE_PUBLIC_KEY=
